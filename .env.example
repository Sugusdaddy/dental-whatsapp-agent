# ═══════════════════════════════════════════
# DENTAL WHATSAPP AGENT - ENVIRONMENT CONFIG
# ═══════════════════════════════════════════

# ─────────────────────────────────────────
# AI (Claude)
# ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─────────────────────────────────────────
# WhatsApp (360dialog)
# ─────────────────────────────────────────
# Obtener en: https://hub.360dialog.com/
DIALOG360_API_KEY=

# ─────────────────────────────────────────
# Database
# ─────────────────────────────────────────
# Si no está configurado, usa MemoryDB (in-memory)
# Para producción: Supabase, Neon, Railway Postgres, etc.
# DATABASE_URL=postgresql://user:password@host:5432/dental_agent

# ─────────────────────────────────────────
# Redis + Celery
# ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# Modo async: encola mensajes en Celery (recomendado en producción)
# false = procesa síncronamente (desarrollo)
ASYNC_MODE=false

# ─────────────────────────────────────────
# Security
# ─────────────────────────────────────────
# Generar con: openssl rand -hex 32
WHATSAPP_WEBHOOK_SECRET=dev_secret_changeme

# En producción: true (valida firma HMAC de 360dialog)
VERIFY_SIGNATURES=false

# ─────────────────────────────────────────
# Google Calendar (opcional)
# ─────────────────────────────────────────
# Crear credenciales OAuth2 en: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────
# Stripe Billing (opcional)
# ─────────────────────────────────────────
# Crear cuenta en: https://stripe.com/
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs de Stripe (crear en Dashboard > Products)
STRIPE_PRICE_STARTER=price_starter
STRIPE_PRICE_PRO=price_pro
STRIPE_PRICE_COMPLETE=price_complete

# ─────────────────────────────────────────
# App Config
# ─────────────────────────────────────────
BASE_URL=http://localhost:8001
ENVIRONMENT=development

# ─────────────────────────────────────────
# Auth (JWT + Admin)
# ─────────────────────────────────────────
# OBLIGATORIOS en producción (ENVIRONMENT=production).
# Generar JWT_SECRET con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=
