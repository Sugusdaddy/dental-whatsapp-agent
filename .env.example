# ═══════════════════════════════════════════
# DENTAL WHATSAPP AGENT - ENVIRONMENT CONFIG
# ═══════════════════════════════════════════

# ─────────────────────────────────────────
# AI (Claude)
# ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─────────────────────────────────────────
# WhatsApp (360dialog)
# ─────────────────────────────────────────
# Obtener en: https://hub.360dialog.com/
DIALOG360_API_KEY=

# ─────────────────────────────────────────
# Database
# ─────────────────────────────────────────
# Si no está configurado, usa MemoryDB (in-memory)
# Para producción: Supabase, Neon, Railway Postgres, etc.
# DATABASE_URL=postgresql://user:password@host:5432/dental_agent

# ─────────────────────────────────────────
# Redis (para Celery - opcional)
# ─────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────
# Security
# ─────────────────────────────────────────
# Generar con: openssl rand -hex 32
WHATSAPP_WEBHOOK_SECRET=dev_secret_changeme

# En producción: true (valida firma HMAC de 360dialog)
VERIFY_SIGNATURES=false

# ─────────────────────────────────────────
# Environment
# ─────────────────────────────────────────
ENVIRONMENT=development
